# joy2-keys.vicerc - extra VICE resources: the joystick in port 2 on the
# keyboard of the PC (Keyset 1): the cursor keys and SPACE for fire.  These
# keys then no longer reach the C64 keyboard.
#
#   JOYKEYS=1 tools/run-vice.sh tests/pacman.prg
#   x64sc -vera -verabase 0xdf00 -addconfig tools/joy2-keys.vicerc +saveres ...
#
# +saveres: with SaveResourcesOnExit=1 VICE would write these keys into
# vicerc on exit, and they would stay a joystick in every session.
#
# Key codes: GDK key symbols (Up $FF52, Down $FF54, Left $FF51, Right $FF53).

[C64]
KeySetEnable=1
JoyDevice2=2
KeySet1North=65362
KeySet1South=65364
KeySet1West=65361
KeySet1East=65363
KeySet1Fire=32

[C64SC]
KeySetEnable=1
JoyDevice2=2
KeySet1North=65362
KeySet1South=65364
KeySet1West=65361
KeySet1East=65363
KeySet1Fire=32

[C128]
KeySetEnable=1
JoyDevice2=2
KeySet1North=65362
KeySet1South=65364
KeySet1West=65361
KeySet1East=65363
KeySet1Fire=32

[SCPU64]
KeySetEnable=1
JoyDevice2=2
KeySet1North=65362
KeySet1South=65364
KeySet1West=65361
KeySet1East=65363
KeySet1Fire=32
